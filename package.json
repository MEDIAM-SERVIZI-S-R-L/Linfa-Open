    "scripts": {
        "build-test": "ng build --configuration test --aot=true --buildOptimizer=true  --output-hashing=all",
        "build-007dev": "ng build --base-href /www/ --configuration 007dev --aot=true --buildOptimizer=true  --output-hashing=all",
        "build-007test": "ng build --base-href /www/ --configuration 007test --aot=true --buildOptimizer=true  --output-hashing=all",
